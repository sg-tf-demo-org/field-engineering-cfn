stages:
  - validate
  - evidence
  - notify

variables:
  PIP_DISABLE_PIP_VERSION_CHECK: "1"

.cfn_changes: &cfn_changes
  changes:
    - cloudformation/appstacks/**/*

cfn-lint:
  stage: validate
  image: public.ecr.aws/docker/library/python:3.12-slim
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
      <<: *cfn_changes
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      <<: *cfn_changes
  before_script:
    - pip install --quiet cfn-lint
  script:
    - |
      set -euo pipefail
      mapfile -t files < <(find cloudformation/appstacks -type f -name 'template.yaml' | sort)
      if [[ ${#files[@]} -eq 0 ]]; then
        echo "No appstack templates found"
        exit 1
      fi
      echo "Linting ${#files[@]} templates"
      cfn-lint "${files[@]}"

governance_evidence:
  stage: evidence
  image: public.ecr.aws/docker/library/alpine:3.20
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  before_script:
    - apk add --no-cache curl jq
  script:
    - |
      set -euo pipefail
      : "${CI_API_V4_URL:?}"
      : "${CI_PROJECT_ID:?}"
      : "${CI_MERGE_REQUEST_IID:?}"
      : "${CI_JOB_TOKEN:?}"
      DESC=$(curl -sS --header "JOB-TOKEN: ${CI_JOB_TOKEN}" \
        "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/merge_requests/${CI_MERGE_REQUEST_IID}" \
        | jq -r '.description // ""')
      echo "$DESC" | grep -q '## Governance' || {
        echo "FAIL: MR description must include a '## Governance' section (gates before PR)."
        exit 1
      }
      echo "OK: governance evidence section present"

# Manual gate: human runs this after MR merge/approval. Posts to Aiden webhook automation.
notify_aiden_deploy:
  stage: notify
  image: public.ecr.aws/docker/library/alpine:3.20
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
      allow_failure: false
  before_script:
    - apk add --no-cache curl jq
  script:
    - |
      set -euo pipefail
      if [[ -z "${AIDEN_DEPLOY_WEBHOOK_URL:-}" ]]; then
        echo "Set CI/CD variable AIDEN_DEPLOY_WEBHOOK_URL to the Aiden Automations webhook URL."
        exit 1
      fi
      ENV_NAME="${DEPLOY_ENV:-prod}"
      PAYLOAD=$(jq -n \
        --arg project "${CI_PROJECT_PATH}" \
        --arg sha "${CI_COMMIT_SHA}" \
        --arg ref "${CI_COMMIT_REF_NAME}" \
        --arg env "${ENV_NAME}" \
        --arg pipeline "${CI_PIPELINE_URL}" \
        '{
          source: "gitlab-ci",
          event: "notify_aiden_deploy",
          project: $project,
          commit_sha: $sha,
          ref: $ref,
          environment: $env,
          pipeline_url: $pipeline,
          instruction: "Deploy changed cloudformation/appstacks/*/template.yaml for environment using mcp-cfn-deploy. Require ## Governance evidence from the associated MR. Stack name aiden-<app>-<env>. Never deploy without governance evidence."
        }')
      echo "Notifying Aiden deploy automation (env=${ENV_NAME})"
      HDRS=(-H "Content-Type: application/json")
      if [[ -n "${AIDEN_DEPLOY_WEBHOOK_TOKEN:-}" ]]; then
        HDRS+=(-H "Authorization: Bearer ${AIDEN_DEPLOY_WEBHOOK_TOKEN}")
      fi
      curl -sS -f -X POST "${AIDEN_DEPLOY_WEBHOOK_URL}" "${HDRS[@]}" -d "${PAYLOAD}"
      echo
      echo "Aiden webhook accepted"

# Aiden bypass path: notify Guild to scan this MR (human-raised or any MR).
notify_aiden_mr_governance:
  stage: notify
  image: public.ecr.aws/docker/library/alpine:3.20
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  before_script:
    - apk add --no-cache curl jq git >/dev/null
  script:
    - |
      set -euo pipefail
      if [[ -z "${AIDEN_MR_GOVERNANCE_WEBHOOK_URL:-}" ]]; then
        echo "WARN: AIDEN_MR_GOVERNANCE_WEBHOOK_URL unset — skip Aiden notify"
        exit 0
      fi
      CHANGED=$(git diff --name-only "${CI_MERGE_REQUEST_DIFF_BASE_SHA:-origin/${CI_MERGE_REQUEST_TARGET_BRANCH_NAME}}...HEAD" 2>/dev/null | head -80 | jq -R -s -c 'split("\n")|map(select(length>0))' || echo '[]')
      PAYLOAD=$(jq -n         --arg project "${CI_PROJECT_PATH}"         --arg mr_iid "${CI_MERGE_REQUEST_IID}"         --arg mr_url "${CI_PROJECT_URL}/-/merge_requests/${CI_MERGE_REQUEST_IID}"         --arg source_branch "${CI_MERGE_REQUEST_SOURCE_BRANCH_NAME}"         --arg target_branch "${CI_MERGE_REQUEST_TARGET_BRANCH_NAME}"         --arg sha "${CI_COMMIT_SHA}"         --arg pipeline "${CI_PIPELINE_URL}"         --argjson changed "$CHANGED"         '{source:"gitlab-ci",event:"mr_governance_scan",project:$project,mr_iid:$mr_iid,mr_url:$mr_url,source_branch:$source_branch,target_branch:$target_branch,sha:$sha,pipeline_url:$pipeline,changed_files:$changed,instruction:"Bypass/human MR — scan governance, notify PASS/FAIL, do not deploy."}')
      curl -sS -f -X POST "$AIDEN_MR_GOVERNANCE_WEBHOOK_URL"         -H "Content-Type: application/json"         -d "$PAYLOAD" | head -c 500 || true
      echo
      echo "OK: notified Aiden MR governance webhook"
  allow_failure: true
